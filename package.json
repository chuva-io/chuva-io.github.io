{
  "name": "@chuva-template-monorepo/root",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/be",
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "build:types": "yarn workspace @chuva-template-monorepo/types build",
    "build:web": "yarn workspace @chuva-template-monorepo/web build",
    "build:less": "yarn workspace @chuva-template-monorepo/less build",
    "build": "yarn build:types && yarn build:web",
    "dev:types": "yarn workspace @chuva-template-monorepo/types dev",
    "dev:web": "yarn workspace @chuva-template-monorepo/web dev",
    "dev:less": "yarn workspace @chuva-template-monorepo/less dev"
  }
}